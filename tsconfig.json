{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "./*": ["./*"] }
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "vendor", "tests", "e2e"]
}
